---
import { ClientRouter } from "astro:transitions";
import NavBarBlog from "../components/secciones/NavBarBlog.astro";
import "../fonts.css";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonicalUrl?: string;
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  authorDescription?: string;
  categories?: string[];
  tags?: string[];
}

const {
  title,
  description,
  keywords,
  image,
  canonicalUrl,
  publishedDate,
  modifiedDate,
  author,
  authorDescription,
  categories,
  tags,
} = Astro.props;

const siteUrl = "https://lachicadelseguro.com";
const defaultImage = `${siteUrl}/resources/Logotipo.svg`;
const resolvedImage = image || defaultImage;
const resolvedCanonical = canonicalUrl || `${siteUrl}/blog`;
const metaDescription = description ? description.slice(0, 160) : "";
const keywordsStr =
  keywords || (tags && tags.length > 0 ? tags.join(", ") : "");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: metaDescription || undefined,
  image: resolvedImage,
  datePublished: publishedDate || undefined,
  dateModified: modifiedDate || publishedDate || undefined,
  author: {
    "@type": "Person",
    name: author || "La Chica del Seguro",
    description: authorDescription || undefined,
    url: siteUrl,
  },
  publisher: {
    "@type": "Organization",
    name: "La Chica del Seguro",
    url: siteUrl,
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/resources/Logotipo.svg`,
    },
  },
  url: resolvedCanonical,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": resolvedCanonical,
  },
  keywords: keywordsStr || undefined,
  articleSection:
    categories && categories.length > 0 ? categories.join(", ") : undefined,
  inLanguage: "es-AR",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO base -->
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {keywordsStr && <meta name="keywords" content={keywordsStr} />}
    <meta name="author" content={author || "La Chica del Seguro"} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="La Chica del Seguro" />
    {
      publishedDate && (
        <meta property="article:published_time" content={publishedDate} />
      )
    }
    {
      (modifiedDate || publishedDate) && (
        <meta
          property="article:modified_time"
          content={modifiedDate || publishedDate}
        />
      )
    }
    {author && <meta property="article:author" content={author} />}
    {categories?.map((cat) => <meta property="article:section" content={cat} />)}
    {tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Structured Data: BlogPosting -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}
    ></script>

    <link rel="icon" type="image/svg+xml" href="/resources/ISO-BLANCO.svg" />
    <link rel="apple-touch-icon" href="/resources/ISO-BLANCO.svg" />
    <link rel="stylesheet" href="../src/fonts.css" />

    <ClientRouter />

    <!-- Meta Pixel Code -->
    <script>
      // @ts-ignore
      !(function (f, b, e, v, n, t, s) {
        // @ts-ignore
        if (f.fbq) return;
        // @ts-ignore
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        // @ts-ignore
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js"
      );
      // @ts-ignore
      fbq("init", "647751594290477");
      // @ts-ignore
      fbq("track", "PageView");
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=647751594290477&ev=PageView&noscript=1"
        title="img pixel facebook"
      /></noscript
    >
    <!-- End Meta Pixel Code -->

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z3S5K1WZQX"
    ></script>
    <script>
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // @ts-ignore
        dataLayer.push(arguments);
      }
      // @ts-ignore
      gtag("js", new Date());
      // @ts-ignore
      gtag("config", "G-Z3S5K1WZQX");
    </script>

    <!-- Metricool tracker -->
    <script>
      function loadScript(a) {
        var b = document.getElementsByTagName("head")[0],
          c = document.createElement("script");
        (c.type = "text/javascript"),
          (c.src = "https://tracker.metricool.com/resources/be.js"),
          // @ts-ignore
          (c.onreadystatechange = a),
          (c.onload = a),
          b.appendChild(c);
      }
      loadScript(function () {
        // @ts-ignore
        beTracker.t({ hash: "694825ac0cb8e427491e13af73a80251" });
      });
    </script>
  </head>
  <body>
    <NavBarBlog />
    <slot />
  </body>
</html>
<style is:global>
  :root {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scrollbar-color: #ed705f96 #90a59c75;
    interpolate-size: allow-keywords;
  }

  html {
    background-color: #fff5eb;
    scroll-behavior: smooth;
  }
</style>

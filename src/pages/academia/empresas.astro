---
//data
import dataPreguntas from "@/data/preguntas_empresas.json";
import dataOpiniones from "@/data/opiniones.json";
import dataSolucion from "@/data/in_company.json";
import dataCursos from "@/data/cursos.json";
import dataRetos from "@/data/regala_curso.json";

//imagenes
import imagenRetos from "@/assets/img_academia/descuento.avif";

//components
import LayoutCursos from "@/layouts/LayoutCursos.astro";
import FooterAcademia from "@/components/academia/secciones/FooterAcademia.astro";
import Opiniones from "@/components/academia/secciones/Opiniones.astro";
import Preguntas from "@/components/academia/secciones/Preguntas.astro";
import PresentacionCurso from "@/components/academia/PresentacionCurso.astro";
import SolucionCursos from "@/components/academia/secciones/SolucionCursos.astro";
import RegalaCurso from "@/components/academia/secciones/RegalaCurso.astro";
import Retos from "@/components/academia/secciones/Retos.astro";
---

<LayoutCursos title="LCS - Academia de Seguros - Negocio de Seguros Digital">
  <main>
    <PresentacionCurso
      id="presentacion"
      titulo1="Servicios y Beneficios"
      titulo2="para Empresas"
      descripcion="Si tenés un equipo de productores o querés potenciar a tu organización, la Academia tiene lo que necesitás. Desde capacitaciones a medida hasta beneficios exclusivos para tus colaboradores, todo pensado para que tu empresa crezca en el mundo digital."
      contenido_before=""
    />

    <SolucionCursos
      data={dataSolucion}
      id="in_company"
      titulo1="Capacitaciones diseñadas"
      titulo2="a la medida de tu empresa"
      contenido_before="In Company"
      descripcion="Diseñamos programas de capacitación específicos para tu equipo. Analizamos tu realidad, tus objetivos y tu mercado, y creamos una propuesta formativa que impacta directamente en los resultados de tu empresa."
    />

    <RegalaCurso
      data={dataCursos}
      id="regala_curso"
      titulo1="Regalá a tus empleados"
      titulo2="un Curso y Mentoria"
      contenido_before="Capacitá"
      descripcion="Elegí el curso que mejor se adapta a lo que tu equipo necesita y regalá acceso completo. Una inversión concreta en el desarrollo profesional de las personas que hacen crecer tu organización."
    />

    <Retos
      data={dataRetos}
      id="descuentos"
      titulo1="Acompaña a tus colaboradores "
      titulo2="en sus nuevos retos"
      contenido_before="Descuentos"
      descripcion="Acompañá a tus colaboradores en cada etapa de su crecimiento. Accedé a descuentos exclusivos para que más personas de tu equipo puedan capacitarse y llevar su desempeño al siguiente nivel."
      img={imagenRetos.src}
      href_contacto="https://api.whatsapp.com/send?phone=+5491122345678&text=Hola!%20Quisiera%20saber%20m%C3%A1s%20sobre%20los%20cursos%20de%20Negocio%20de%20Seguros%20Digital"
    />

    <Preguntas
      data={dataPreguntas}
      id="preguntas_frecuentes"
      titulo1="¿Tenes preguntas?"
      titulo2="Tenemos las respuestas"
      contenido_before="Preguntas"
    />
    <!-- <Opiniones
      data={dataOpiniones}
      id="opiniones"
      titulo1="Algunos de nuestros clientes"
      titulo2="opinan de nosotros"
      contenido_before="Opiniones"
    /> -->
    <FooterAcademia />
  </main>
</LayoutCursos>
